{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@ai/*": ["./src/ai/*"],
      "@config": ["./src/config/index.ts"],
      "@controllers/*": ["./src/controllers/*"],
      "@db/*": ["./src/db/*"],
      "@parsers/*": ["./src/parsers/*"],
      "@services/*": ["./src/services/*"],
      "@types/*": ["./src/types/*"],
    },

    "target": "esnext",
    "module": "nodenext",
    "types": ["node"],
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  }
}
